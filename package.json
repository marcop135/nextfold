{
  "name": "nextfold",
  "version": "0.9.4",
  "private": true,
  "description": "Next.js App Router and Sanity demo: typed sections, schema guardrails, and Studio",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typegen": "sanity schema extract --enforce-required-fields --force --path src/sanity/schema.json && sanity typegen generate",
    "changelog:lint": "node scripts/changelog-lint.mjs",
    "smoke": "node scripts/smoke.mjs",
    "content:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content-check.mjs",
    "seed:import": "sanity exec scripts/import-seed.ts --with-user-token",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs"
  },
  "dependencies": {
    "@sanity/vision": "^6.23.0",
    "next": "^16.4.6",
    "next-sanity": "^13.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "refractor": "^5.0.0",
    "sanity": "^6.23.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.9",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5.9.3",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "^3.15.2",
      "smol-toml": "^1.9.1"
    },
    "@oclif/core": {
      "minimatch": "^11.0.1"
    }
  }
}
